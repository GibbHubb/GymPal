# GymPal Backend — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/gympal

# JWT Auth (JWT_SECRET and REFRESH_TOKEN_SECRET are required; the server refuses to start without them)
JWT_SECRET=your-secret-key-here
REFRESH_TOKEN_SECRET=your-refresh-secret-here
# Access-token lifetime (jsonwebtoken format: 15m, 1h, 7d). Refresh tokens last 7d.
JWT_EXPIRES_IN=15m

# Email (optional — weekly summaries are skipped when SMTP_HOST is unset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="GymPal" <noreply@gympal.app>
