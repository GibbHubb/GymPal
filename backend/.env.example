# GymPal Backend — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/gympal

# JWT Auth (JWT_SECRET and REFRESH_TOKEN_SECRET are required; the server refuses to start without them)
JWT_SECRET=your-secret-key-here
REFRESH_TOKEN_SECRET=your-refresh-secret-here
# Access-token lifetime (jsonwebtoken format: 15m, 1h, 7d). Refresh tokens last 7d.
JWT_EXPIRES_IN=15m

# G49 — CORS allowlist (comma-separated). The local Expo/react-native-web dev origins
# (localhost:8081, localhost:19006) are always allowed and do not need to be listed here.
# Add the landing page's production domain and any preview deploy origins that need to
# call this API from a browser. Native app builds (iOS/Android) send no Origin header and
# are unaffected by this setting either way.
# CORS_ORIGINS=https://gympal.example.com

# Email (optional — weekly summaries are skipped when SMTP_HOST is unset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="GymPal" <noreply@gympal.app>
