{
  "expo": {
    "name": "GymPal",
    "slug": "GymPal",
    "version": "1.0.0",
    "web": {
      "bundler": "metro"
    },
    "scheme": "gympal",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.gibbhubb.gympal",
      "supportsTablet": true
    },
    "android": {
      "package": "com.gibbhubb.gympal"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#FFD700"
        }
      ]
    ]
  }
}
